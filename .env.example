# MIKE Agent Configuration

# Agent Settings
MIKE_NAME=MIKE
MIKE_VOICE_ENABLED=true
MIKE_AUTO_START=false
MIKE_DEBUG_MODE=false

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_CLOUD_KEY=path/to/google_cloud_key.json

# Voice Settings
VOICE_RATE=150
VOICE_LANGUAGE=en-US

# Windows Automation
AUTOMATION_ENABLED=true
SAFE_MODE=false

# Database
DATABASE_URL=postgresql://user:password@localhost/mike_db
REDIS_URL=redis://localhost:6379

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Storage
TASK_DATA_FILE=data/tasks.json
